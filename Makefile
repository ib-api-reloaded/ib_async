# ``ib_async`` build / dev targets.
#
# Protobuf bindings under ``ib_async/_pb/`` are generated artifacts.
# They are gitignored and regenerated by ``scripts/generate_protos.py``.
# Local dev runs ``make protos`` once after ``uv sync``. Releases go
# through releasekit (configured under [tool.releasekit] in
# pyproject.toml), which regenerates them in a clean export of HEAD before
# building the wheel and source distribution, so end users get the
# bindings bundled into the package without needing ``protoc`` or
# ``grpcio-tools``.

.PHONY: help sync protos audit twsapi-status twsapi-bump build release-check release publish-dry-run publish publish-test ruff typecheck lint test test-matrix format clean

PYTHON ?= uv run python
PB_DIR := ib_async/_pb
RELEASEKIT ?= releasekit

# test: per-test limit, and extra `uv run` arguments, e.g. local sibling
# checkouts during development:
#   UV_RUN_ARGS="--with=../eventkit --with=../nest_asyncio --with=pytest"
# --with=pytest puts a pytest into the overlay environment; otherwise `pytest`
# resolves to .venv/bin/pytest, which runs .venv's interpreter and never sees
# the overlay. Not --with-editable, which puts those repositories (and their
# own `tests` packages) on sys.path. test-matrix runs `make test` per Python
# version, so both apply there too, but it installs wheels only: pass the
# siblings' built wheels instead of their directories, e.g.
#   --with=../eventkit/dist/aeventkit-2.2.0-py3-none-any.whl
TEST_TIMEOUT ?= 60
UV_RUN_ARGS ?=
PYTEST := pytest -q -p no:cacheprovider --timeout=$(TEST_TIMEOUT) --timeout-method=thread
# test-matrix: a subset of the configured Python versions, e.g. "3.13 3.15".
PYTHONS ?=

help:
	@echo "Targets:"
	@echo "  sync     - uv sync --all-groups (install deps + dev extras)"
	@echo "  protos   - fetch+extract TWS API archive (if needed), regenerate $(PB_DIR)/"
	@echo "  twsapi-status - pinned TWS API vs what IBKR still serves"
	@echo "  twsapi-bump V=<version> - re-pin TWS API (fetch, verify, prime cache)"
	@echo "  build    - regenerate protos, then build sdist + wheel into dist/"
	@echo "  release-check - every reason not to publish this version now"
	@echo "  release  - protos + lint + audit + test, build from HEAD, smoke install; no upload"
	@echo "  publish-dry-run - everything publish does locally; prints the upload and tag steps"
	@echo "  publish  - release, upload to PyPI, tag, verify the published release"
	@echo "  publish-test - the same against TestPyPI"
	@echo "  test     - run the owned test suite"
	@echo "  test-matrix - run the suite on each configured Python version, each in its"
	@echo "                own .venvs/py<version> environment and time-boxed; logs in"
	@echo "                .venvs/logs/ (PYTHONS=\"3.13 3.15\" for a subset)"
	@echo "  ruff     - ruff check + ruff format --check"
	@echo "  typecheck - mypy"
	@echo "  lint     - ruff + typecheck"
	@echo "  format   - ruff format"
	@echo "  clean    - remove dist/, build/, $(PB_DIR)/, caches"

sync:
	uv sync --all-groups

# Version + SHA256 of the TWS API archive are pinned in pyproject.toml
# under [tool.ib_async.twsapi]. The script handles fetch / cache /
# SHA-verify / extract / protoc — no manual setup needed.
protos:
	uv run --group protos python scripts/generate_protos.py

# IBKR prunes old TWS API archives without notice. ``twsapi-status``
# reports whether the pinned one is still downloadable alongside the
# versions IBKR currently publishes; ``twsapi-bump`` re-pins to one of
# them after checking the archive carries the .proto schemas the build
# needs.
twsapi-status:
	$(PYTHON) scripts/twsapi.py status

twsapi-bump:
	@test -n "$(V)" || (echo "usage: make twsapi-bump V=<version>"; exit 2)
	$(PYTHON) scripts/twsapi.py bump $(V)

# Wheel + sdist always bundle freshly-generated bindings. The
# ``protos`` prerequisite guarantees ``ib_async/_pb/`` exists with
# current schemas before hatchling scans for ``artifacts`` globs.
build: protos
	uv build

# Release pipeline (steps in [tool.releasekit]): protos, lint, audit and
# tests in the working tree; then protos and build in a clean export of
# HEAD, metadata check and a clean-environment smoke install. ``publish``
# adds the preflight checks (pushed, untagged, unpublished, higher
# version, changelog), the upload, the tag and a smoke install from PyPI.
release-check:
	$(RELEASEKIT) check

release:
	$(RELEASEKIT) release

publish-dry-run:
	$(RELEASEKIT) publish --dry-run

publish:
	$(RELEASEKIT) publish

publish-test:
	$(RELEASEKIT) publish --test-pypi

# CI calls ruff / typecheck / test / protos / build, so a local run of
# these targets is exactly what CI runs.
ruff:
	uv run ruff check .
	uv run ruff format --check .

typecheck:
	uv run mypy --pretty ib_async/

lint: ruff typecheck

test:
	uv run --no-dev --group test $(UV_RUN_ARGS) $(PYTEST)

test-matrix:
	$(RELEASEKIT) matrix $(foreach v,$(PYTHONS),--python=$(v))

format:
	uv run python -m ruff format ib_async/ tests/

clean:
	rm -rf dist/ build/ $(PB_DIR)/ .mypy_cache/ .ruff_cache/
	find . -type d -name __pycache__ -exec rm -rf {} +
